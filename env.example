# Example values only; configure actual secrets in Railway Variables.
# Leave the existing SECRET_KEY unchanged on an existing deployment.
# SECRET_KEY=your-long-random-secret
DATA_DIR=/data
PRODUCTION=1
COOKIE_SECURE=1
FLASK_DEBUG=0
ENABLE_DEMO_DATA=0
PUBLIC_BASE_URL=https://booking.kiteclub.gr
LOCAL_EMAIL_PREVIEW=0

# Railway Free/Trial/Hobby: use HTTPS delivery. Configure a verified sender domain.
EMAIL_PROVIDER=resend
EMAIL_FROM=KiteClub Booking <booking@notify.kiteclub.gr>
EMAIL_REPLY_TO=sales@kiteclub.gr
RESEND_API_KEY=

# Alternative SMTP (Railway Pro or higher only): set EMAIL_PROVIDER=smtp.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=booking@kiteclub.gr
# Port 465 requires SMTP_SECURITY=ssl. TLS is always verified.

# For initializing a NEW, EMPTY production database only:
# ADMIN_EMAIL=your-admin@example.com
# ADMIN_PASSWORD=your-unique-12-plus-character-password
# Existing Railway PORT is injected automatically; no local launcher on production.

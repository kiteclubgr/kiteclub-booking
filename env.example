# Optional: generated automatically; for long-term deployments set this manually
# SECRET_KEY=replace-with-a-long-random-secret
DATA_DIR=/data
COOKIE_SECURE=1
FLASK_DEBUG=0

# Railway injects PORT automatically. Local default is 5000.
PORT=5000

# Optional email settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=booking@kiteclub.gr

# v75: Required only when initializing a NEW database with no users

# ADMIN_EMAIL=your-admin@example.com
# ADMIN_PASSWORD=replace-with-a-unique-12-plus-character-password
# DEMO EDITION: enabled by default on local AND Railway.
# DO NOT use real customer data on this public demo.
ENABLE_DEMO_DATA=1

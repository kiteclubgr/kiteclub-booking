# Required in production
SECRET_KEY=replace-with-a-long-random-secret
DATA_DIR=/data
COOKIE_SECURE=1
FLASK_DEBUG=0

# Railway injects PORT automatically. Local default is 5000.
PORT=5000

# Optional email settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=booking@kiteclub.gr

# Optional Google login: set securely in Railway, never commit real credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://booking.kiteclub.gr/auth/google/callback
